{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-and-run",
            "type": "shell",
            "command": "C:\\mingw64\\bin\\g++.exe",
            "args": [
                "-g",
                "main.cpp",
                "src/Task.cpp",
                "src/TaskRepository.cpp", 
                "src/TaskService.cpp",
                "src/ConsoleUI.cpp",
                "-o",
                "main.exe",
                "&&",
                "start",
                "cmd",
                "/k",
                "main.exe"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": "$gcc"
        }
    ]
}